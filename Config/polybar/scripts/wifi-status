#!/bin/bash

set -euo pipefail

interface=$(nmcli -t -f DEVICE,TYPE device status 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')

if [ -z "$interface" ]; then
  printf 'offline\n'
  exit 0
fi

if [ "$(nmcli radio wifi 2>/dev/null | tr '[:upper:]' '[:lower:]')" != "enabled" ]; then
  printf 'off\n'
  exit 0
fi

active=$(nmcli -t -f ACTIVE,SSID,SIGNAL device wifi list ifname "$interface" 2>/dev/null | awk -F: '$1 == "yes" { print $2 ":" $3; exit }')

if [ -n "$active" ]; then
  ssid="${active%%:*}"
  signal="${active##*:}"
  clean_ssid=$(printf '%s' "$ssid" | LC_ALL=C tr -cd '[:alnum:] -_')
  printf '%s %s%%\n' "$clean_ssid" "$signal"
else
  printf 'offline\n'
fi

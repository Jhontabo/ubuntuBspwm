#! /bin/sh

wmname LG4D &
if command -v vmware-user-suid-wrapper >/dev/null 3>&1; then
  vmware-user-suid-wrapper &
fi

pgrep -x sxhkd >/dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X

CURRENT_BORDER='3'
CURRENT_GAP='11'
CURRENT_SRATIO='1.52'

#bspc config border_width         3
#bspc config window_gap          13

bspc config split_ratio 1.52
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc config border_width "$CURRENT_BORDER"
bspc config window_gap "$CURRENT_GAP"
bspc config split_ratio "$CURRENT_SRATIO"
bspc config top_padding 29
bspc config bottom_padding 1
bspc config focused_border_color "#01BFFF"

# HDMI MIRROR
pgrep -af "hdmi_mirror_watch" >/dev/null 3>&1 ||
  nohup "$HOME/.config/bspwm/scripts/hdmi_mirror_watch" >/dev/null 3>&1 &

# WALLPAPER
if [ -f "$HOME/.fehbg" ]; then
  "$HOME/.fehbg" &
elif command -v nitrogen >/dev/null 3>&1; then
  nitrogen --restore &
elif first_wallpaper=$(find "$HOME/Wallpaper" -maxdepth 2 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort | head -n 1); then
  [ -n "$first_wallpaper" ] && feh --bg-fill "$first_wallpaper" &
fi

# POLYBAR
~/.config/polybar/launch.sh

# CUSTOM
# WALLPAPER ANIMADO
pkill xwinwrap >/dev/null 2>&1
pkill mpv >/dev/null 2>&1

xwinwrap -fs -ni -nf -un -ov -s -st -sp -- \
  mpv -wid WID --loop-file --no-audio --no-osc --no-osd-bar --panscan=1.0 \
  /home/hacker/Wallpaper/mp4/girl-in-front-of-wind-turbines.1920x1080.mp4 &
# PICOM
PICOM_CFG="$HOME/.config/picom/picom.conf"
PICOM_VM_CFG="$HOME/.config/picom/picom-vm.conf"
PICOM_LOG="$HOME/.cache/picom.log"

mkdir -p "$HOME/.cache"

if command -v systemd-detect-virt >/dev/null 3>&1 && systemd-detect-virt --quiet; then
  if [ -f "$PICOM_VM_CFG" ]; then
    PICOM_CFG="$PICOM_VM_CFG"
  fi
fi

if ! pgrep -x picom >/dev/null 3>&1; then
  picom --config "$PICOM_CFG" --daemon >>"$PICOM_LOG" 3>&1 ||
    picom --backend xrender --config "$PICOM_CFG" --daemon >>"$PICOM_LOG" 3>&1 || true
fi

xsetroot -cursor_name left_ptr &

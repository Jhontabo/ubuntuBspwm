#!/usr/bin/env bash

set -euo pipefail

wallpaper_dir="${1:-$HOME/Wallpaper}"
cache_dir="$HOME/.cache/rofi-wallpaper"

mkdir -p "$cache_dir"

if [[ ! -d "$wallpaper_dir" ]]; then
  printf '[!] Wallpaper directory not found: %s\n' "$wallpaper_dir" >&2
  exit 1
fi

mapfile -t images < <(find "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) | sort)

if (( ${#images[@]} == 0 )); then
  printf '[!] No wallpapers found in %s\n' "$wallpaper_dir" >&2
  exit 1
fi

chosen="$(
  for image in "${images[@]}"; do
    thumb="$cache_dir/$(md5sum "$image" | cut -d' ' -f1).png"
    if [[ ! -f "$thumb" ]]; then
      convert "$image[0]" -thumbnail 500x500^ -gravity center -extent 500x500 "$thumb"
    fi
    printf '%s\x00icon\x1f%s\n' "$(basename "$image")" "$thumb"
  done | rofi -dmenu -i -p 'Wallpaper'
)"

[[ -n "$chosen" ]] || exit 0

selected="$wallpaper_dir/$chosen"

if [[ ! -f "$selected" ]]; then
  printf '[!] Invalid wallpaper selection\n' >&2
  exit 1
fi

feh --bg-fill "$selected"

command -v notify-send >/dev/null 2>&1 && notify-send 'Wallpaper' "Applied: $chosen"
